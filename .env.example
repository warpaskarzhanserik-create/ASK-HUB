# Postgres connection string (Neon → Dashboard → Connection string)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Your login
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# Random string, 32+ chars (e.g. `openssl rand -base64 32`)
AUTH_SECRET=
# Vercel Blob token (Vercel → Storage → Blob → .env.local). Added automatically on Vercel.
BLOB_READ_WRITE_TOKEN=
